# Copy to .env and fill in. Do NOT commit .env (it is gitignored).
# Note: the service does not currently load .env automatically (no dotenv);
# these are documented here and read from the process environment.

# HTTP port the service listens on
PORT=9000

# Jobs / working directory (defaults to /tmp/jobs)
JOBS_DIR=/tmp/jobs

# Shared bearer token for service-to-service auth. Any app that calls the
# automations must send `Authorization: Bearer <RENDER_API_TOKEN>`.
# Required for all state-changing requests (POST/PUT/PATCH/DELETE); if it is
# unset the service rejects those requests with 503 (fail-closed).
# Generate a strong random value, e.g.:  openssl rand -hex 32
# RENDER_API_TOKEN=replace-with-a-long-random-secret

# Music generation provider (Musicful)
# MUSICFUL_API_KEY=your-key-here

# Copy to .env and fill in. Do NOT commit .env (it is gitignored).
# Note: the service does not currently load .env automatically (no dotenv);
# these are documented here and read from the process environment.

# HTTP port the service listens on
PORT=9000

# Jobs / working directory (defaults to /tmp/jobs)
JOBS_DIR=/home/isaac/jobs;

# Music generation provider (Musicful)
# MUSICFUL_API_KEY=your-key-here
